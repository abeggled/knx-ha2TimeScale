[Unit]
Description=knx-ha2TimeScale web UI
Documentation=https://github.com/abeggled/knx-ha2TimeScale
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=collector
WorkingDirectory=/opt/knx-ha2timescale
# /var/lib/knx-ha2timescale — holds the KNX Secure keyring, written by the UI
StateDirectory=knx-ha2timescale
StateDirectoryMode=0750
EnvironmentFile=/etc/knx-ha2timescale-ui.env
ExecStart=/opt/knx-ha2timescale/.venv/bin/python -u ui.py
Restart=always
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK AF_PACKET
MemoryMax=256M

[Install]
WantedBy=multi-user.target
