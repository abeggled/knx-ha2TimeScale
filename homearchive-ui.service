[Unit]
Description=homearchive web UI
Documentation=https://github.com/abeggled/homearchive
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=collector
WorkingDirectory=/opt/homearchive
# /var/lib/homearchive — holds the KNX Secure keyring, written by the UI
StateDirectory=homearchive
StateDirectoryMode=0750
EnvironmentFile=/etc/homearchive-ui.env
ExecStart=/opt/homearchive/.venv/bin/python -u ui.py
Restart=always
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK AF_PACKET
MemoryMax=256M

[Install]
WantedBy=multi-user.target
