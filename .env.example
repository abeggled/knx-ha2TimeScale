# Copy to .env (gitignored) or use as a systemd EnvironmentFile.
KNX_DSN=host=db.example.local dbname=knx_data user=collector
HA_DSN=host=db.example.local dbname=ha_data user=collector
# Home Assistant long-lived access token
HA_TOKEN=
# ETS project password (alternatively ~/.knx.pwd)
KNX_PROJECT_PASSWORD=
