[Unit]
Description=homearchive collector (KNX + Home Assistant -> TimescaleDB)
Documentation=https://github.com/abeggled/homearchive
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=collector
WorkingDirectory=/opt/homearchive
# /var/lib/homearchive — holds the KNX Secure keyring, written by the UI
StateDirectory=homearchive
StateDirectoryMode=0750
EnvironmentFile=/etc/homearchive.env
ExecStart=/opt/homearchive/.venv/bin/python -u service.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10

# Hardening — the service needs the network and nothing else.
# AF_NETLINK/AF_PACKET are required: xknx enumerates local interfaces via
# ifaddr to pick the source IP for the KNX tunnel.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK AF_PACKET
MemoryMax=256M

[Install]
WantedBy=multi-user.target
